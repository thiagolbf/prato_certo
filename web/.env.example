# Copie para web/.env.local (fora do controle de versão).

# Endereço da API para onde o Next.js reescreve /api/* (ADR-006). Não há valor
# padrão no código: sem esta variável, "npm run dev" e "npm run build" falham.
# Local: a API do Docker Compose ou do "uv run uvicorn". Produção: a URL do Render.
API_URL=http://localhost:8000
