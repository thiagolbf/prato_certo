# Copie para .env (fora do controle de versão) e troque os valores (RN-47).

# PostgreSQL local do Docker Compose. A senha não pode ter "@", ":" ou "/",
# porque vai dentro da DATABASE_URL montada pelo docker-compose.yml.
POSTGRES_USER=pfmarmitas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pfmarmitas
POSTGRES_PORTA=5432

# Banco usado por "uv run pytest", criado automaticamente no mesmo servidor.
POSTGRES_DB_TESTE=pfmarmitas_test

# Segredo da sessão. Gere um valor longo e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_SESSAO=troque-por-um-valor-aleatorio

API_PORTA=8000

# Parâmetros opcionais da API (padrões na seção 3 do PLAN-001):
# BANCO_TIMEOUT_SEGUNDOS=5
# SESSAO_INATIVIDADE_ADMIN_MIN=30
# SESSAO_INATIVIDADE_OPERADOR_MIN=720
# BLOQUEIO_TENTATIVAS=5
# BLOQUEIO_MINUTOS=[1,5,15,60]
# CORPO_MAXIMO_BYTES=16384
# FORCAR_HTTPS=false
